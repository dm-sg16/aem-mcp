# Template for the secrets file consumed by the Docker Compose stack.
# Copy to aem-mcp-secrets.properties (no .example suffix), fill in real values,
# then `chmod 600 secrets/aem-mcp-secrets.properties`.
# The real file is gitignored (see .gitignore: secrets/*.properties).
#
# Generate a strong bearer token with:  openssl rand -hex 32

# AEM read-only service-account credentials.
aem.username=svc-aem-readonly
aem.password=REPLACE_ME

# Shared bearer token clients must present on /sse (Authorization: Bearer ...).
aem-mcp.token=REPLACE_ME
