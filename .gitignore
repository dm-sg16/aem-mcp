# Maven build output
target/

# Secrets — only the .example template is committed.
secrets/*.properties
.env

# TLS truststores / certs — only certs/README.md and certs/.gitkeep are committed.
certs/*.jks
certs/*.p12
certs/*.pem
certs/*.crt
certs/*.cer

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
